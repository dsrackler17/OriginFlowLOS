{
  "name": "originflow-worker",
  "version": "0.1.0",
  "tasks": {
    "dev":   "deno run --allow-net --allow-env --allow-read --watch main.ts",
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "check": "deno check main.ts",
    "fmt":   "deno fmt .",
    "lint":  "deno lint ."
  },
  "imports": {
    "@anthropic-ai/sdk":     "npm:@anthropic-ai/sdk@^0.32.1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.45.0",
    "postgres":              "npm:postgres@^3.4.4"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "deno.window", "esnext"]
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  }
}
